oin-Path $root 'Versions') -Force | Select-Object Name,Attributes}); ProductStateExists=(Test-Path -LiteralPath $stateKey); State=$(if(Test-Path -LiteralPath $stateKey){Get-ItemProperty -LiteralPath $stateKey | Select-Object Version,VersionPath,Publisher,UserSid,CertificateCreated,CertificateThumbprint}else{$null}); UninstallEntryExists=(Test-Path -LiteralPath $uninstallKey); Uninstall=$(if(Test-Path -LiteralPath $uninstallKey){Get-ItemProperty -LiteralPath $uninstallKey | Select-Object DisplayVersion,InstallLocation,UninstallString}else{$null}); Packages=@(Get-AppxPackage -Name SmartZip.Modern | Select-Object PackageFullName,Status); PackagedCom=@(if(Test-Path -LiteralPath $comRoot){Get-ChildItem -LiteralPath $comRoot | Where-Object {$_.PSChildName -like 'SmartZip.Modern_*'} | Select-Object PSChildName}); NativeComCU=(Test-Path -LiteralPath ('HKCU:\Software\Classes\CLSID\'+$clsid)); NativeComLM=(Test-Path -LiteralPath ('HKLM:\Software\Classes\CLSID\'+$clsid)); ShortcutDirectoryExists=(Test-Path -LiteralPath (Join-Path ([Environment]::GetFolderPath('Programs')) 'SmartZip')); Certificates=@(foreach($location in @('LocalMachine','CurrentUser')){foreach($store in @('TrustedPeople','Root')){$path='Cert:\'+$location+'\'+$store+'\'+$thumb; $physical=$(if($location -eq 'LocalMachine'){'HKLM:'}else{'HKCU:'})+'\SOFTWARE\Microsoft\SystemCertificates\'+$store+'\Certificates\'+$thumb; $certificate=if(Test-Path -LiteralPath $path){Get-Item -LiteralPath $path}else{$null}; [pscustomobject]@{Store=$location+'\'+$store; Visible=($null -ne $certificate); PhysicalKeyExists=(Test-Path -LiteralPath $physical); Subject=$certificate.Subject; HasPrivateKey=$certificate.HasPrivateKey}}}); TrustOwnershipKeyExists=(Test-Path -LiteralPath ('HKLM:\SOFTWARE\SmartZipModernTestTrust\'+$thumb)); UserConfig=@($entries | Where-Object {!$_.PSIsContainer} | Sort-Object FullName | ForEach-Object {[pscustomobject]@{Path=$_.FullName.Substring($config.Length+1); Bytes=$_.Length; SHA256=(Get-FileHash -LiteralPath $_.FullName).Hash}}); Explorer=@(Get-Process explorer -ErrorAction SilentlyContinue | Select-Object Id,StartTime)} }; function Clean($s) { return (!$s.RootExists -and !$s.ProductStateExists -and !$s.UninstallEntryExists -and !$s.ShortcutDirectoryExists -and !$s.NativeComCU -and !$s.NativeComLM -and !$s.TrustOwnershipKeyExists -and @($s.Packages).Count -eq 0 -and @($s.PackagedCom).Count -eq 0 -and @($s.Certificates | Where-Object {$_.Visible -or $_.PhysicalKeyExists}).Count -eq 0) }; $before=Snapshot; if(!(Clean $before)){throw 'Live installation/registration/certificate baseline is not clean; no cleanup or repair attempted.'}; if(($before.UserConfig | ConvertTo-Json -Compress) -ne ($prior.After.UserConfig | ConvertTo-Json -Compress)){throw 'Preserved settings differ from reviewed uninstall state; stop and inspect.'}; $target=$output+'\normal-reinstall-0.1.0.14'; if(Test-Path -LiteralPath $target){throw 'Reinstall evidence already exists. No automatic retry.'}; New-Item -ItemType Directory -Path $target | Out-Null; $evidence=$target; $before | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath (Join-Path $evidence 'before.json') -Encoding UTF8; if((Get-FileHash -LiteralPath $installer).Hash -ne $expectedHash){throw 'Installer changed after snapshot.'}; $log=Join-Path $evidence 'reinstall-inno.log'; $process=Start-Process -FilePath $installer -ArgumentList ('/NORESTART /LOG='+[char]34+$log+[char]34) -WindowStyle Normal -PassThru -Wait; $after=Snapshot; [ordered]@{InstallerExitCode=$process.ExitCode; InstallerSHA256=$expectedHash; FinishedUtc=[DateTime]::UtcNow.ToString('o'); Baseline='No product installation, package, COM or certificate; user configuration deliberately retained'; ConfigUnchanged=(($before.UserConfig | ConvertTo-Json -Compress) -eq ($after.UserConfig | ConvertTo-Json -Compress)); After=$after; Note='Only the normal installer ran; no manual fallback or retry. Modern menu and extraction still require validation.'} | ConvertTo-Json -Depth 9 | Set-Content -LiteralPath (Join-Path $evidence 'result.json') -Encoding UTF8; $logs=Join-Path $evidence 'helper-logs'; New-Item -ItemType Directory -Path $logs | Out-Null; $copied=@(foreach($source in @(Get-ChildItem -LiteralPath $env:TEMP -Filter 'SmartZip-0.1.0.14-*.log' -File)){if(($source.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0){throw 'Linked helper log refused.'}; $hash=(Get-FileHash -LiteralPath $source.FullName).Hash; $copy=Join-Path $logs $source.Name; [IO.File]::Copy($source.FullName,$copy,$false); if((Get-FileHash -LiteralPath $copy).Hash -ne $hash -or (Get-FileHash -LiteralPath $source.FullName).Hash -ne $hash){throw 'Log changed; keep partial evidence.'}; [pscustomobject]@{Name=$source.Name; SHA256=$hash; Bytes=$source.Length}}); $copied | ConvertTo-Json -Depth 4 | Set-Content -LiteralPath (Join-Path $evidence 'logs.json') -Encoding UTF8; Write-Output ('INSTALLER EXIT: '+$process.ExitCode); Write-Output 'COLLECTED before/after state and logs. Keep this installation for review.'; Write-Output $evidence; exit 0 } catch {if($evidence){[IO.File]::WriteAllText((Join-Path $evidence 'test-error.txt'),$_.Exception.ToString())}; [Console]::Error.WriteLine($_.Exception.ToString()); exit 1 }"
