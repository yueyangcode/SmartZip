@echo off
setlocal
if /i not "%USERNAME%"=="WDAGUtilityAccount" (
  echo STOP: Run this INSIDE Windows Sandbox only.
  if /i not "%~1"=="--no-pause" pause
  exit /b 1
)
echo Prepare writable test samples only. No installation, extraction or system changes.
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -Command "$ErrorActionPreference='Stop'; $created=$null; try { if($env:USERNAME -ne 'WDAGUtilityAccount' -or (Get-CimInstance Win32_ComputerSystem).Model -ne 'Virtual Machine'){throw 'Sandbox required; host execution refused.'}; function Under($root,$relative){$full=[IO.Path]::GetFullPath((Join-Path $root $relative)); if(!$full.StartsWith(($root.TrimEnd('\')+'\'),[StringComparison]::OrdinalIgnoreCase)){throw 'Unsafe fixture path.'}; return $full}; $inputRoot='C:\SmartZipTestInput\FunctionalFixtures'; $output='C:\SmartZipTestOutput'; if(!(Test-Path -LiteralPath $output -PathType Container)){throw 'Mapped output required.'}; $packages=@(Get-AppxPackage -Name SmartZip.Modern); if($packages.Count -ne 1 -or $packages[0].Version.ToString() -ne '0.1.0.14' -or $packages[0].Status.ToString() -ne 'Ok' -or (Get-ItemProperty 'HKCU:\Software\SmartZipModern').Version -ne '0.1.0.14'){throw 'Expected healthy 0.1.0.14 registration; stop and inspect.'}; $manifestPath=Join-Path $inputRoot 'manifest.json'; $manifest=Get-Content -LiteralPath $manifestPath -Raw -Encoding UTF8 | ConvertFrom-Json; if($manifest.Version -ne '0.1.0.14' -or $manifest.Cases.Count -ne 13 -or $manifest.Files.Count -ne 23){throw 'Unexpected test manifest.'}; $target=$output+'\functional-tests-0.1.0.14'; if(Test-Path -LiteralPath $target){throw 'Test directory already exists. Do not overwrite or reset completed tests.'}; foreach($relative in $manifest.Directories){$source=Under $inputRoot $relative; if(((Get-Item -LiteralPath $source).Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0){throw 'Linked fixture directory refused.'}}; foreach($file in $manifest.Files){$source=Under $inputRoot $file.Path; if(((Get-Item -LiteralPath $source).Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0 -or (Get-FileHash -LiteralPath $source).Hash -ne $file.SHA256){throw 'Fixture checksum/link check failed.'}}; New-Item -ItemType Directory -Path $target | Out-Null; $created=$target; $cases=Join-Path $target 'Cases'; New-Item -ItemType Directory -Path $cases | Out-Null; foreach($relative in $manifest.Directories){New-Item -ItemType Directory -Path (Under $cases $relative) | Out-Null}; foreach($file in $manifest.Files){$source=Under $inputRoot $file.Path; $destination=Under $cases $file.Path; [IO.File]::Copy($source,$destination,$false); if((Get-FileHash -LiteralPath $destination).Hash -ne $file.SHA256){throw 'Copy verification failed; keep partial evidence.'}}; [IO.File]::Copy($manifestPath,(Join-Path $target 'manifest.json'),$false); $readme=@(Get-ChildItem -LiteralPath $inputRoot -Filter '*.txt' -File | Where-Object {$_.Name -ne 'libarchive-LICENSE.txt'}); if($readme.Count -ne 1){throw 'Expected one test instruction file.'}; [IO.File]::Copy($readme[0].FullName,(Join-Path $target $readme[0].Name),$false); [ordered]@{StartedUtc=[DateTime]::UtcNow.ToString('o'); Computer=$env:COMPUTERNAME; User=$env:USERNAME; ManifestSHA256=(Get-FileHash -LiteralPath (Join-Path $target 'manifest.json')).Hash; Package=$packages[0].PackageFullName; Explorer=@(Get-Process explorer -ErrorAction SilentlyContinue | Select-Object Id,StartTime); CasesPath=$cases; MenuAcceptance='Not yet observed'; ExtractionAcceptance='Not yet observed'} | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath (Join-Path $target 'started.json') -Encoding UTF8; Write-Output 'READY: 13 cases copied and verified. Test them manually in Cases; no extraction has run.'; exit 0 } catch {if($created){[IO.File]::WriteAllText((Join-Path $created 'prepare-error.txt'),$_.Exception.ToString())}; [Console]::Error.WriteLine($_.Exception.ToString()); exit 1 }"
set "prepare_exit=%ERRORLEVEL%"
if "%prepare_exit%"=="0" start "" "%SystemRoot%\explorer.exe" "C:\SmartZipTestOutput\functional-tests-0.1.0.14"
echo Preparation exit code: %prepare_exit%
echo Open Cases, test the modern context menu manually, then run Collect-Functional-Results.cmd.
echo Keep Sandbox open. Do not uninstall or run fault installers.
if /i not "%~1"=="--no-pause" pause
exit /b %prepare_exit%
