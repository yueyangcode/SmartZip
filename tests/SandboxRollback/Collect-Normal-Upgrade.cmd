@echo off
setlocal
if /i not "%USERNAME%"=="WDAGUtilityAccount" (
  echo STOP: Run this INSIDE the current Windows Sandbox only.
  if /i not "%~1"=="--no-pause" pause
  exit /b 1
)
echo Read-only collection after the NORMAL SmartZip 0.1.0.14 upgrade.
echo No installation, cleanup, package, registry or certificate changes.
echo This collects evidence; it does NOT mark menu or extraction tests as passed.
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -Command "$ErrorActionPreference='Stop'; $destination=$null; try { if($env:USERNAME -ne 'WDAGUtilityAccount' -or (Get-CimInstance Win32_ComputerSystem).Model -ne 'Virtual Machine'){throw 'Sandbox required; host execution refused.'}; $output='C:\SmartZipTestOutput'; $probe=Get-Content -LiteralPath ($output+'\probe.json') -Raw | ConvertFrom-Json; if($probe.Computer -ne $env:COMPUTERNAME){throw 'Wrong Sandbox session.'}; $baseline=$output+'\rollback-continuation-20260909-212727-after-state\after-state\after.json'; if((Get-FileHash -LiteralPath $baseline -Algorithm SHA256).Hash -ne '8AEBE3AD8A59ECAFB07118414150EC0F2A720BC5A4329CB6D64ED19A1B20BB50'){throw 'Reviewed rollback baseline missing or changed.'}; $target=$output+'\normal-upgrade-0.1.0.14-first-state'; if(Test-Path -LiteralPath $target){throw 'Evidence already exists. Do not overwrite or rerun.'}; New-Item -ItemType Directory -Path $target | Out-Null; $destination=$target; $root=Join-Path $env:LOCALAPPDATA 'Programs\SmartZip'; $versionPath=Join-Path $root 'Versions\0.1.0.14'; $thumb='A1709CED9DB02150E2FB40CE6496BD1938D89195'; $clsid='{C12835D9-8B49-48D9-AE52-5E66D31209E1}'; $result=[ordered]@{Purpose='Read-only evidence, not functional acceptance'; CollectedUtc=[DateTime]::UtcNow.ToString('o'); User=$env:USERNAME; Computer=$env:COMPUTERNAME; UserSid=[Security.Principal.WindowsIdentity]::GetCurrent().User.Value; ExpectedVersion='0.1.0.14'; Root=$root; VersionDirectoryExists=(Test-Path -LiteralPath $versionPath -PathType Container); ProductState=$null; Uninstall=$null}; $os=Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion'; $result.OS=$os | Select-Object EditionID,DisplayVersion,CurrentBuild,UBR; $state='HKCU:\Software\SmartZipModern'; if(Test-Path -LiteralPath $state){$result.ProductState=Get-ItemProperty -LiteralPath $state | Select-Object Version,VersionPath,Publisher,UserSid,CertificateCreated,CertificateThumbprint}; $uninstall='HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\{DA975784-DC84-48EF-9A47-F60C0C969280}_is1'; if(Test-Path -LiteralPath $uninstall){$result.Uninstall=Get-ItemProperty -LiteralPath $uninstall | Select-Object DisplayName,DisplayVersion,InstallLocation,UninstallString}; $packages=@(Get-AppxPackage -Name SmartZip.Modern); $result.Packages=@(foreach($package in $packages){$manifest=Get-AppxPackageManifest -Package $package.PackageFullName; [IO.File]::WriteAllText((Join-Path $destination ($package.PackageFullName+'.xml')),$manifest.OuterXml,[Text.Encoding]::UTF8); [pscustomobject]@{FullName=$package.PackageFullName; Version=$package.Version.ToString(); Publisher=$package.Publisher; Status=$package.Status.ToString(); InstallLocation=$package.InstallLocation; PackagedComClassExists=(Test-Path -LiteralPath ('Registry::HKEY_CLASSES_ROOT\PackagedCom\Package\'+$package.PackageFullName+'\Class\'+$clsid))}}); $result.Certificates=@(foreach($store in @('LocalMachine\TrustedPeople','CurrentUser\TrustedPeople','LocalMachine\Root','CurrentUser\Root')){$path='Cert:\'+$store+'\'+$thumb; if(Test-Path -LiteralPath $path){$cert=Get-Item -LiteralPath $path; [pscustomobject]@{Store=$store; Thumbprint=$cert.Thumbprint; Subject=$cert.Subject; HasPrivateKey=$cert.HasPrivateKey; NotBefore=$cert.NotBefore.ToUniversalTime().ToString('o'); NotAfter=$cert.NotAfter.ToUniversalTime().ToString('o')}}}); $result.CertificateNote='Logical CurrentUser stores can inherit LocalMachine certificates; this does not establish physical ownership.'; $result.RootEntries=@(if(Test-Path -LiteralPath $root){Get-ChildItem -LiteralPath $root -Force | Select-Object Name,Length,Attributes}); $result.VersionEntries=@(if(Test-Path -LiteralPath (Join-Path $root 'Versions')){Get-ChildItem -LiteralPath (Join-Path $root 'Versions') | Select-Object Name,Attributes}); $result.VersionFiles=@(if(Test-Path -LiteralPath $versionPath){Get-ChildItem -LiteralPath $versionPath -File | Select-Object Name,Length}); $result.Explorer=@(Get-Process -Name explorer -ErrorAction SilentlyContinue | Select-Object Id,StartTime); $result.LegacyUnZipExists=Test-Path -LiteralPath 'HKCU:\Software\Classes\*\shell\UnZip'; $logDir=Join-Path $destination 'helper-logs'; New-Item -ItemType Directory -Path $logDir | Out-Null; $logs=@(foreach($source in @(Get-ChildItem -LiteralPath $env:TEMP -Filter 'SmartZip-0.1.0.14-*.log' -File)){if(($source.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0){throw 'Refusing a linked helper log.'}; $hash=(Get-FileHash -LiteralPath $source.FullName -Algorithm SHA256).Hash; $copy=Join-Path $logDir $source.Name; [IO.File]::Copy($source.FullName,$copy,$false); if((Get-FileHash -LiteralPath $copy -Algorithm SHA256).Hash -ne $hash -or (Get-FileHash -LiteralPath $source.FullName -Algorithm SHA256).Hash -ne $hash){throw 'Helper log changed during collection. Preserve partial evidence.'}; [pscustomobject]@{Name=$source.Name; Length=$source.Length; SHA256=$hash; LastWriteTimeUtc=$source.LastWriteTimeUtc.ToString('o')}}); $result.HelperLogs=$logs; $result.LogNote='Complete helper logs include earlier fault tests and reused PIDs. Review timestamps and appended bytes; do not classify old errors as this upgrade.'; $result | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath (Join-Path $destination 'state.json') -Encoding UTF8; Write-Output 'COLLECTED: current version, registration, certificate metadata and helper logs.'; Write-Output $destination; exit 0 } catch { if($destination){[IO.File]::WriteAllText((Join-Path $destination 'collection-error.txt'),$_.Exception.ToString())}; [Console]::Error.WriteLine($_.Exception.ToString()); exit 1 }"
set "collect_exit=%ERRORLEVEL%"
echo Collection exit code: %collect_exit%
echo Send this result to the developer. Keep Sandbox open; do not uninstall yet.
if /i not "%~1"=="--no-pause" pause
exit /b %collect_exit%
