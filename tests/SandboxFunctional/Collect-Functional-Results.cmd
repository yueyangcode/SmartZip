@echo off
setlocal
if /i not "%USERNAME%"=="WDAGUtilityAccount" (
  echo STOP: Run this INSIDE Windows Sandbox only.
  if /i not "%~1"=="--no-pause" pause
  exit /b 1
)
echo Read-only collection of test outputs and relevant application error events.
echo No automatic extraction, menu clicks, repair, uninstall or system changes.
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -Command "$ErrorActionPreference='Stop'; try { if($env:USERNAME -ne 'WDAGUtilityAccount' -or (Get-CimInstance Win32_ComputerSystem).Model -ne 'Virtual Machine'){throw 'Sandbox required; host execution refused.'}; function Under($root,$relative){$full=[IO.Path]::GetFullPath((Join-Path $root $relative)); if(!$full.StartsWith(($root.TrimEnd('\')+'\'),[StringComparison]::OrdinalIgnoreCase)){throw 'Unsafe evidence path.'}; return $full}; $root='C:\SmartZipTestOutput\functional-tests-0.1.0.14'; $casesRoot=Join-Path $root 'Cases'; $started=Get-Content -LiteralPath (Join-Path $root 'started.json') -Raw -Encoding UTF8 | ConvertFrom-Json; if($started.Computer -ne $env:COMPUTERNAME){throw 'Different Sandbox session.'}; $manifestPath=Join-Path $root 'manifest.json'; if((Get-FileHash -LiteralPath $manifestPath).Hash -ne $started.ManifestSHA256){throw 'Test manifest changed.'}; $manifest=Get-Content -LiteralPath $manifestPath -Raw -Encoding UTF8 | ConvertFrom-Json; $results=@(foreach($case in $manifest.Cases){$path=Under $casesRoot $case.Name; $inputs=@($manifest.Files | Where-Object {$_.Path.StartsWith(($case.Name+'\'),[StringComparison]::OrdinalIgnoreCase)}); $inputNames=@($inputs | ForEach-Object {Under $casesRoot $_.Path}); $changed=@(foreach($file in $inputs){$name=Under $casesRoot $file.Path; if(!(Test-Path -LiteralPath $name -PathType Leaf) -or (Get-FileHash -LiteralPath $name).Hash -ne $file.SHA256){$file.Path}}); $entries=@(Get-ChildItem -LiteralPath $path -Recurse -Force); if(@($entries | Where-Object {($_.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0}).Count){throw 'Linked test output refused.'}; $new=@($entries | Where-Object {!$_.PSIsContainer -and $_.FullName -notin $inputNames} | ForEach-Object {[pscustomobject]@{Path=$_.FullName.Substring($casesRoot.Length+1); Bytes=$_.Length; SHA256=(Get-FileHash -LiteralPath $_.FullName).Hash}}); $expected=@($case.ExpectedPayloadHashes | Sort-Object); $actual=@($new | ForEach-Object {$_.SHA256} | Sort-Object); $same=($expected.Count -eq $actual.Count -and ($expected -join ',') -eq ($actual -join ',')); $status='NOT_OBSERVED_OR_MISMATCH'; if($changed.Count){$status='INPUT_CHANGED'} elseif($same){if($expected.Count){$status='EXPECTED_CONTENT_PRESENT'}else{$status='NO_EXTRACTION_OUTPUT_PRESENT'}}; [pscustomobject]@{Case=$case.Name; ContentObservation=$status; ChangedInputs=$changed; ExpectedPayloadHashes=$expected; NewFiles=$new; MenuVisibility='REQUIRES_USER_REPORT'}}); $eventStatus='OK'; $events=@(); try{$events=@(Get-WinEvent -FilterHashtable @{LogName='Application'; Id=1000,1001,1002; StartTime=([DateTimeOffset]::Parse($started.StartedUtc).LocalDateTime)} -ErrorAction Stop | Where-Object {$_.Message -match 'SmartZip|explorer.exe|dllhost.exe'} | Select-Object TimeCreated,Id,ProviderName,Message)}catch{if($_.FullyQualifiedErrorId -notlike 'NoMatchingEventsFound*'){$eventStatus=$_.Exception.Message}}; $result=[ordered]@{CollectedUtc=[DateTime]::UtcNow.ToString('o'); Computer=$env:COMPUTERNAME; Started=$started; Cases=$results; Packages=@(Get-AppxPackage -Name SmartZip.Modern | Select-Object PackageFullName,Status); ExplorerNow=@(Get-Process explorer -ErrorAction SilentlyContinue | Select-Object Id,StartTime); RelevantApplicationErrors=$events; EventQueryStatus=$eventStatus; Limitations='File content does not prove modern-menu invocation, exact arguments or UI responsiveness. Require user observations.'}; $destination=Join-Path $root ('result-'+[Guid]::NewGuid().ToString('N')+'.json'); $stream=[IO.File]::Open($destination,[IO.FileMode]::CreateNew); $writer=[IO.StreamWriter]::new($stream,[Text.UTF8Encoding]::new($true)); try{$writer.Write(($result | ConvertTo-Json -Depth 10))}finally{$writer.Dispose()}; $results | Select-Object Case,ContentObservation | Format-Table -AutoSize; Write-Output 'COLLECTED. Menu/UI acceptance still requires your report.'; Write-Output $destination; exit 0 } catch {[Console]::Error.WriteLine($_.Exception.ToString()); exit 1 }"
set "collect_exit=%ERRORLEVEL%"
echo Collection exit code: %collect_exit%
echo Send this screenshot plus which menu tests passed or failed. Keep Sandbox open.
if /i not "%~1"=="--no-pause" pause
exit /b %collect_exit%
